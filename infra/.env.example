# Non-secret environment template for the MCPX GCP gateway and deployment scripts.
# Real values and MCP server tokens live in Google Drive folder `mcpx/`
# (`mcpx.agent.env` for GCP/infra settings and `mcpx.mcps.env` for all MCP tokens).
# Manage which MCP servers are enabled via `scripts/mcp-servers.sh`.

GCP_PROJECT_ID=mcpx-515813
GCP_REGION=us-east1
GCP_ZONE=us-east1-b
VM_NAME=mcpx-gateway
STATIC_IP_NAME=mcpx-gateway-ip

# Gateway domain (scripts fall back to DOMAIN if MCP_SUBDOMAIN is unset)
MCP_SUBDOMAIN=mcpx.duckdns.org

# Gateway Bearer token (stored in mcpx.mcps.env; never commit real tokens)
MCP_BEARER_TOKEN=REPLACE_WITH_64_HEX_CHAR_TOKEN

# Path to downloaded mcpx.mcps.env containing MCP_BEARER_TOKEN and any per-server
# tokens/settings copied to ~/mcp-server/.env by scripts/deploy-vm.sh.
# MCPS_ENV_FILE=/tmp/mcpx-secrets.XXXXXX/mcpx.mcps.env

# Optional: space-separated override for enabled servers in scripts/mcp-servers.sh
# MCP_SERVERS="context7 uv-time gemini-sound mcpx-logs"

# Optional: extra flags forwarded to scripts/e2e-test.py by scripts/deploy-vm.sh
# E2E_EXTRA_ARGS=
