# Store real config & secrets in Google Drive folder `mcpx/` (1E0Ml9EUgTNMEZDWNqxmMXoX_VM5A6mL0):
#   - `mcpx.agent.env`      : GCP/agent infra vars (GCP_PROJECT_ID, DOMAIN, SERVICE_ACCOUNT_MAIN)
#   - `mcpx.mcps.env`       : MCP gateway & server secrets (MCP_BEARER_TOKEN, GEMINI_TOKEN)
#   - `mcpx-agent-key.json` : GCP service account JSON key
# Source both env files before running scripts, and never commit secrets to git.
GCP_PROJECT_ID=mcpx-515813
GCP_REGION=us-east1
GCP_ZONE=us-east1-b
VM_NAME=mcpx-gateway
STATIC_IP_NAME=mcpx-gateway-ip
# Canonical subdomain variable (scripts automatically fall back to DOMAIN if MCP_SUBDOMAIN is unset)
MCP_SUBDOMAIN=mcpx.duckdns.org
MCP_BEARER_TOKEN=REPLACE_WITH_64_HEX_CHAR_TOKEN

# Optional: enable servers/gemini-mcp with ENABLE_GEMINI=1 (merges infra/config.gemini-overlay.json)
# Scripts and server.py automatically fall back to GEMINI_TOKEN if GEMINI_API_KEY is unset.
# GEMINI_API_KEY=
# GEMINI_DEFAULT_MODEL=
# GEMINI_USE_VERTEXAI=false
# Optional: extra flags forwarded to scripts/e2e-test.py by scripts/deploy-vm.sh (e.g. "--call-gemini")
# E2E_EXTRA_ARGS=
