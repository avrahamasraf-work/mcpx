{
  "mcpProxy": {
    "baseURL": "https://${MCP_SUBDOMAIN}",
    "addr": ":9000",
    "name": "MCPX Gateway",
    "version": "1.0.0",
    "type": "streamable-http",
    "startupGracePeriod": "90s",
    "options": {
      "panicIfInvalid": false,
      "logEnabled": true,
      "autoReconnect": true,
      "authTokens": [
        "${MCP_BEARER_TOKEN}"
      ]
    }
  },
  "mcpServers": {}
}
